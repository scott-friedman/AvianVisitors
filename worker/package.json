{
  "name": "avian-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker for AvianVisitors (bird) — detection ingest + JSON API over D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply avian-detections --local",
    "migrate:remote": "wrangler d1 migrations apply avian-detections --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node --check src/index.js && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "wrangler": "^4.110.0"
  }
}
